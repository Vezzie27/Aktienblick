<!doctype html><html lang="de"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#101827"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-title" content="Aktienblick"><title>Aktienblick – News</title><style>:root{color-scheme:dark;--bg:#0b1220;--panel:#131e30;--muted:#9aa9bf;--line:#25344a;--blue:#82b1ff}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:#f3f6fb;font:16px -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}header{padding:calc(18px + env(safe-area-inset-top)) 18px 14px;background:#101827;position:sticky;top:0;z-index:2;border-bottom:1px solid var(--line)}h1{font-size:23px;margin:0 0 5px}.sub,.status{color:var(--muted);font-size:13px}.wrap{max-width:760px;margin:auto;padding:16px 14px 100px}.tabs{display:flex;gap:8px;overflow:auto;padding:2px 0 13px}.tab{white-space:nowrap;border:1px solid var(--line);border-radius:999px;background:var(--panel);color:#dbe5f3;padding:10px 13px;font-weight:600}.tab.active{background:#244574;border-color:#3972b9}.tools{display:flex;gap:8px;margin:4px 0 14px}.tools input{flex:1;min-width:0;background:var(--panel);color:white;border:1px solid var(--line);border-radius:12px;padding:12px;font-size:15px}.tools button{border:1px solid var(--line);background:var(--panel);color:white;border-radius:12px;padding:10px 12px}.card{background:var(--panel);border:1px solid var(--line);border-radius:15px;padding:14px;margin:10px 0}.meta{font-size:12px;color:var(--muted);display:flex;gap:8px;flex-wrap:wrap}.source{color:var(--blue);font-weight:650}.card h2{font-size:17px;line-height:1.35;margin:9px 0}.desc{color:#c4cfde;line-height:1.45;font-size:14px;margin:0 0 12px}.actions{display:flex;gap:16px}.actions a,.fav{color:var(--blue);text-decoration:none;font-size:14px}.fav{background:none;border:0;padding:0}.empty{padding:28px 16px;color:var(--muted);text-align:center;border:1px dashed var(--line);border-radius:14px}.note{font-size:12px;line-height:1.5;color:#8292a9;margin-top:22px}.foot{position:fixed;bottom:0;left:0;right:0;background:#101827ee;border-top:1px solid var(--line);padding:10px 14px calc(10px + env(safe-area-inset-bottom));text-align:center;color:var(--muted);font-size:12px}</style></head><body><header><h1>Aktienblick</h1><div class="sub">Aktien- und Unternehmensnews, übersichtlich sortiert</div></header><main class="wrap"><nav class="tabs" id="tabs"></nav><div class="tools"><input id="search" type="search" placeholder="Unternehmen oder Schlagwort suchen"><button id="favorites">☆ Merkliste</button><button id="reload">↻</button></div><div class="status" id="status">Lade Meldungen…</div><section id="stories"></section><p class="note">Schlagzeilen aus RSS-Feeds mit Link zur Originalquelle. Verfügbarkeit und Nutzung hängen von den Bedingungen der Anbieter ab. Keine Anlageberatung.</p></main><div class="foot">Private News-Übersicht · Originalartikel bei der Quelle lesen</div><script>
const WORKER_URL='https://aktienblick-news.maikevitt99.workers.dev';
const CATS=[{id:'de',label:'DE / EU Mittelstand'},{id:'us',label:'US-Tech & Wachstum'},{id:'startups',label:'Startups & junge Firmen'}];let selected='de',all=[],showFav=false;const $=s=>document.querySelector(s),esc=s=>String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));function favs(){try{return JSON.parse(localStorage.getItem('aktienblick-favs')||'[]')}catch{return []}}function drawTabs(){$('#tabs').innerHTML=CATS.map(c=>`<button class="tab ${selected===c.id?'active':''}" data-id="${c.id}">${c.label}</button>`).join('');document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{selected=b.dataset.id;showFav=false;$('#favorites').textContent='☆ Merkliste';drawTabs();load()})}function render(){let q=$('#search').value.toLowerCase(),ids=new Set(favs()),rows=all.filter(x=>(showFav?ids.has(x.id):x.cat===selected)&&(!q||(x.title+' '+x.source+' '+x.desc).toLowerCase().includes(q)));rows.sort((a,b)=>Date.parse(b.date||0)-Date.parse(a.date||0));$('#stories').innerHTML=rows.length?rows.map(x=>`<article class="card"><div class="meta"><span class="source">${esc(x.source)}</span><span>${x.date?new Date(x.date).toLocaleString('de-DE',{dateStyle:'medium',timeStyle:'short'}):''}</span></div><h2>${esc(x.title)}</h2>${x.desc?`<p class="desc">${esc(x.desc.slice(0,230))}${x.desc.length>230?'…':''}</p>`:''}<div class="actions"><a href="${esc(x.link)}" target="_blank" rel="noopener">Zum Originalartikel ↗</a><button class="fav" data-id="${esc(x.id)}">${ids.has(x.id)?'★ Gespeichert':'☆ Merken'}</button></div></article>`).join(''):'<div class="empty">Für diese Ansicht sind gerade keine Meldungen verfügbar.</div>';document.querySelectorAll('.fav').forEach(b=>b.onclick=()=>{let a=favs(),i=a.indexOf(b.dataset.id);i<0?a.push(b.dataset.id):a.splice(i,1);localStorage.setItem('aktienblick-favs',JSON.stringify(a));render()})}async function load(){if(WORKER_URL.startsWith('HIER_')){$('#status').textContent='News-Dienst noch nicht verbunden – Worker-Adresse in index.html eintragen.';$('#stories').innerHTML='<div class="empty">Zuerst den Worker veröffentlichen und seine Adresse in den Code kopieren.</div>';return}$('#status').textContent='Lade Nachrichten…';try{let r=await fetch(WORKER_URL.replace(/\/$/,'')+'/news?category='+encodeURIComponent(selected));if(!r.ok)throw Error('HTTP '+r.status);let d=await r.json();all=(d.items||[]).map(x=>({id:x.link,cat:x.category,source:x.source,title:x.title,link:x.link,desc:x.description||'',date:x.date||''}));$('#status').textContent=`${all.length} Meldungen geladen${d.errors?.length?` · ${d.errors.length} Feed(s) nicht erreichbar`:''}`;render()}catch(e){$('#status').textContent='News-Dienst nicht erreichbar. URL/Deployment prüfen.';$('#stories').innerHTML='<div class="empty">Konnte den Worker nicht erreichen. Kontrolliere die Adresse und Deployment.</div>'}}$('#search').oninput=render;$('#reload').onclick=load;$('#favorites').onclick=()=>{showFav=!showFav;$('#favorites').textContent=showFav?'★ Merkliste':'☆ Merkliste';render()};drawTabs();load();</script></body></html>
